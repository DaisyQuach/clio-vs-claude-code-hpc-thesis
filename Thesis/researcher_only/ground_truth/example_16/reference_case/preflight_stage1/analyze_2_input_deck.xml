    <ParameterList name="Spatial Model">
      <ParameterList name="Domains">
        <ParameterList name="block_1">
          <Parameter name="Element Block" type="string" value="block_1" />
          <Parameter name="Material Model" type="string" value="material_1" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Material Models">
      <ParameterList name="material_1">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Youngs Modulus" type="double" value="1.0" />
          <Parameter name="Poissons Ratio" type="double" value="0.3" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Concentrated Loads">
      <ParameterList name="Concentrated Load with ID 0">
        <Parameter name="Dof" type="int" value="1" />
        <Parameter name="Value" type="double" value="-1" />

      <ParameterList name="Displacement Y with ID 2">
        <Parameter name="Type" type="string" value="Fixed Value" />
        <Parameter name="Index" type="int" value="1" />
        <Parameter name="Sides" type="string" value="ns_fix" />
        <Parameter name="Value" type="double" value="0" />
      </ParameterList>
      <ParameterList name="Displacement Z with ID 3">
        <Parameter name="Type" type="string" value="Fixed Value" />
        <Parameter name="Index" type="int" value="2" />
        <Parameter name="Sides" type="string" value="ns_fix" />
        <Parameter name="Value" type="double" value="0" />
      </ParameterList>
    </ParameterList>
    <ParameterList name="Output">
      <Parameter name="Plottable" type="Array(string)" value="{displacement_x, displacement_y, displacement_z}" />
    </ParameterList>
  </ParameterList>
</ParameterList>

# CLIO arm configuration for the planned counted CLIO trials (E1, E2 and E3). Researcher-owned. No secrets.
# Values that begin with "TBD" are PLACEHOLDERS: dry runs render them, every --execute-counted entry point refuses
# until they are replaced with the researcher's decision. Change nothing between trials of one experiment.
#
# Shared with the baseline (read from Thesis/automation/lib/common.sh, never redefined here): model claude-fable-5-1,
# agent-host Slurm contract (1 node, 1 task, 8 CPU, 32G, 02:00:00, hochhalter-np), session limit 6600 s,
# frozen packets FROZEN-EX8-v1 / FROZEN-EX16-v1, prompts, scorer and acceptance specs.

# --- CLIO software (pins) -------------------------------------------------------------------------------------
CLIO_PREFIX=/uufs/chpc.utah.edu/common/home/chet/Daisy/clioSessions/CLIOruntime
CLIO_AGENT_VERSION_PIN="TBD-clio-agent-version"        # installed at pilot time: 0.9.5b5.post2 (checked against the install)
CLIO_CORE_VERSION_PIN="TBD-clio-core-version"          # recorded in the trial manifest only
CLIO_DESKTOP_VERSION="TBD-clio-desktop-version"        # Desktop is observation-only; never connected to send/answer during a trial

# --- agent arm -------------------------------------------------------------------------------------------------
CLIO_BLUEPRINT_ID="TBD-blueprint-id"                   # pilots: factorio-flat (stock) | factorio-flat-hpc (variant) | none (standard agent)
CLIO_BLUEPRINT_VERSION="TBD-blueprint-version"         # pilots: 0.4.0 | 0.4.0-hpc.1; verified at GET /v1/sessions/{sid}/agent-blueprint
CLIO_BLUEPRINT_SOURCE_DIR=""                           # optional: a blueprint directory copied into each deployment's OWN config only
                                                       # (e.g. a frozen copy of factorio-flat-hpc); empty = use the installed blueprint

# --- session behaviour (parity decisions; pilot values in comments) -----------------------------------------------
CLIO_EFFORT=default            # default = send no effort, so the Claude Code CLI default governs (as in the baseline). Pilots: high
CLIO_APPROVAL_MODE=bypass      # baseline: --dangerously-skip-permissions. Sent at session creation AND on the message
CLIO_MAX_NUDGES=0              # baseline sends exactly one prompt per session. Pilots (E1/E2): up to 4 fixed nudges
CLIO_ANSWER_QUESTIONS=never    # waiting_user / waiting_permission ends the session (cancelled), as a headless baseline would stop
CLIO_MCP_POLICY=none           # none = no MCP servers (frozen network policy: no web search). as_installed = pilot config (web MCP)
CLIO_CLAUDE_CLI_PIN=2.1.295    # the Claude Code CLI CLIO's claude_code provider drives; same binary as the baseline (PATH shim).
                               # Without the shim CLIO picks the newest installed CLI (pilots ran 2.1.296; bundled is 2.1.292)

# --- CLIO runtime tuning (each deployment's own environment only) -------------------------------------------------------
# Pilot program 20261011_tuned: CLIO defaults (15 / 600 / 900) caused full-context re-sends after every tool call >15 s
# and an E3 turn failure. Set to 15 / 600 / 900 to run CLIO stock.
CLIO_CLAUDE_CODE_STREAM_IDLE_TTL_S=3600
CLIO_MCP_CALL_TIMEOUT_S=3600
CLIO_GACT_TURN_TIMEOUT_S=5400

# --- isolation -------------------------------------------------------------------------------------------------------
CLIO_CORE_ISOLATION=private    # private = own clio-core daemon per session (CLIO_RUNTIME_STATE_DIR + CLIO_CORE_PORT); shared = the
                               # node's host-global daemon (port 9413), which other CLIO deployments on the node also use (pilots)

# --- telemetry ----------------------------------------------------------------------------------------------------------
CLIO_POLL_SECONDS=15
CLIO_STREAM_AUDIT=1            # CLIO_STREAM_AUDIT_LOG in the deployment (session-reset reasons, per-call SDK usage incl. cache writes)

# E3 baseline configuration (copy to baseline_e3_config.env; researcher-owned). No secrets belong here.
# Pinned baseline system: identical to the active thesis baseline protocol (Thesis/automation/lib/common.sh,
# Thesis/researcher_only/RESEARCHER_DECISIONS.md): Claude Code 2.1.295, model claude-fable-5-1.
E3_CLAUDE_PIN_VERSION=2.1.295
E3_CLAUDE_BIN_REL=.local/share/claude/versions/2.1.295     # relative to $HOME; records show it as $HOME/...
E3_CLAUDE_MODEL=claude-fable-5-1
E3_SESSION_TIMEOUT_SECONDS=6600                            # 1 h 50 min inside the 2 h agent-host allocation (same as E1/E2)
# Private control repository, read noninteractively at this exact commit
E3_CONTROL_REPO_URL=git@github.com:DaisyQuach/daisy-e3-distributed-context-control.git
E3_CONTROL_COMMIT=333edab8ebcaeaef96b8b2b2243c6e0da155853b
# Globus (mandatory, researcher decision 2026-10-10): "globus" requires a configured private read-only collection and a
# noninteractive CLI session. "posix_readonly_fallback" is withdrawn: direct local reading is not an equivalent fallback,
# and the runner refuses it. Pinned CLI: automation/environment/tools/globus-cli-3.43.0 (venv, python/3.12.4).
E3_GLOBUS_MODE=globus
E3_GLOBUS_CLI_REL=automation/environment/tools/globus-cli-3.43.0/bin/globus   # relative to the E3 root; pinned 3.43.0
E3_GLOBUS_COLLECTION_ID=
# Access model (same as E1/E2): researcher-only material is excluded from the agent-visible packet; agents are instructed
# (prompt, protocol/access_rules.md) and audited (automation/audit_boundary.sh) not to access it. Same-account processes,
# including Slurm jobs, are not technically prevented from reading it. The automation/sandbox/ prototype is optional and
# is not the runtime boundary. The only accepted value is procedural_researcher_only.
E3_ACCESS_MODEL=procedural_researcher_only
# Node-local root: Slurm per-job $TMPDIR = /scratch/local/<account>/<jobid> (CHPC; $SLURM_TMPDIR is unset).
# Researcher decision 2026-10-10: the account name may appear in staging paths in trial records.
E3_ALLOW_ACCOUNT_NAME_IN_TMPDIR=1

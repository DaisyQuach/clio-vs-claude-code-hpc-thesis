## E3-SPC-v1 Symmetry-Plane Cantilever: half of the 2 x 1 x 1 Helmholtz-filter cantilever,
## z in [0, 0.5], cut plane z = 0.5 is the symmetry plane (sideset ss_sym).
## Adapted from the candidate example_07 journal (full domain, 48 x 24 x 24); here the
## width is halved (wd = 0.5 -> 48 x 24 x 12 HEX8) and the symmetry sideset is added.
## Fixed on the x = 0 face (ns_fix), transverse line load along the edge x = 2, y = 0 (ns_load).
reset
#{len = 2.0}
#{ht  = 1.0}
#{wd  = 0.5}
#{esize = 0.0416667}
## --- geometry: half brick with the back-bottom-left corner at the origin ---
create brick x {len} y {ht} z {wd}
move volume 1 x {len/2.0} y {ht/2.0} z {wd/2.0}
## --- structured (mapped) hex mesh, uniform size 1/24: 48 x 24 x 12 ---
volume 1 scheme map
volume 1 size {esize}
mesh volume 1
block 1 volume 1
block 1 name 'block_1'
block 1 element type HEX8
## --- fixed support: all nodes on the x = 0 face ---
nodeset 1 add node in surface with x_coord < {esize/2.0}
nodeset 1 name "ns_fix"
## --- transverse line load: edge x = len, y = 0, spanning z in [0, wd] ---
nodeset 2 add node with x_coord > {len - esize/2.0} and with y_coord < {esize/2.0}
nodeset 2 name "ns_load"
## --- symmetry (cut) plane: all element faces on z = wd ---
sideset 1 add surface with z_coord > {wd - esize/2.0}
sideset 1 name "ss_sym"
export mesh "mesh.exo" dimension 3 overwrite

## E3-SPC-v1 Symmetry-Plane Cantilever: half domain z in [0, 0.5] of the 2 x 1 x 1 cantilever.
## Structured HEX8 mesh, h = 1/24 (48 x 24 x 12 elements). Adapted from the structure of the
## candidate example_07 journal (full domain); geometry, sets and sideset are per the frozen specification.
reset
#{len = 2.0}
#{ht  = 1.0}
#{wd  = 0.5}
#{esize = 0.0416667}
## --- geometry: brick with its corner at the origin, x in [0,2], y in [0,1], z in [0,0.5] ---
create brick x {len} y {ht} z {wd}
move volume 1 x {len/2.0} y {ht/2.0} z {wd/2.0}
## --- structured (mapped) hex mesh, uniform element size h = 1/24 ---
volume 1 scheme map
volume 1 size {esize}
mesh volume 1
## --- single design block containing every element ---
block 1 volume 1
block 1 name 'block_1'
block 1 element type HEX8
## --- fixed support: all nodes on the x = 0 face ---
nodeset 1 add node in surface with x_coord < {esize/2.0}
nodeset 1 name "ns_fix"
## --- transverse line load: nodes on the edge x = 2, y = 0, spanning z in [0, 0.5] ---
nodeset 2 add node with x_coord > {len - esize/2.0} and with y_coord < {esize/2.0}
nodeset 2 name "ns_load"
## --- symmetry (cut) plane: all element faces on z = 0.5 ---
sideset 1 add surface with z_coord > {wd - esize/4.0}
sideset 1 name "ss_sym"
## --- export Exodus II, dimension 3 ---
export mesh "mesh.exo" dimension 3 overwrite

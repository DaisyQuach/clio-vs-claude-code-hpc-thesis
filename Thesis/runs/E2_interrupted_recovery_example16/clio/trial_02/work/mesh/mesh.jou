# Frozen workflow EX16 -- full cantilever design domain, structured HEX8 mesh
# Domain: x in [0,2], y in [0,1], z in [0,1], corner at origin; h = 1/24
reset
brick x 2.0 y 1.0 z 1.0
move volume 1 x 1.0 y 0.5 z 0.5 include_merged
volume 1 scheme map
curve all interval size 0.041666666666667
volume 1 size 0.041666666666667
mesh volume 1
block 1 add volume 1
block 1 name "block_1"
block 1 element type HEX8
nodeset 1 add surface with x_coord < 0.0001 and x_coord > -0.0001
nodeset 1 name "ns_fix"
nodeset 2 add curve with x_coord > 1.9999 and y_coord < 0.0001 and y_coord > -0.0001
nodeset 2 name "ns_load"
list block 1
list nodeset 1
list nodeset 2
set exodus netcdf4 off
export mesh "mesh.exo" dimension 3 overwrite

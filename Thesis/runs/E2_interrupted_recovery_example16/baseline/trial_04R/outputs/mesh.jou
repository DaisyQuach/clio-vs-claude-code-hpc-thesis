## Frozen workflow EX16 (FROZEN-EX16-v1): full cantilever design domain
## Brick x in [0,2], y in [0,1], z in [0,1]; structured HEX8 mesh, h = 1/24
## 48 x 24 x 24 = 27,648 elements, 30,625 nodes
## block_1 = whole domain; ns_fix = face x=0 (625 nodes); ns_load = edge x=2,y=0 (25 nodes)
reset
undo off
brick x 2.0 y 1.0 z 1.0
## brick is created centred at the origin; move its corner to the origin
move volume 1 x 1.0 y 0.5 z 0.5 include_merged
## structured (mapped) hex mesh with exact interval counts
volume 1 scheme map
curve all interval 24
curve with length > 1.5 interval 48
mesh volume 1
## single element block containing every element
block 1 add volume 1
block 1 name "block_1"
block 1 element type HEX8
## nodesets selected by nodal coordinates (tolerance 1e-6)
nodeset 1 add node with x_coord < 1.0e-6
nodeset 1 name "ns_fix"
nodeset 2 add node with x_coord > 1.999999
nodeset 2 remove node with y_coord > 1.0e-6
nodeset 2 name "ns_load"
## report
list block 1
list nodeset 1
list nodeset 2
list volume 1
export mesh "/uufs/chpc.utah.edu/common/home/chet/Daisy/Thesis/runs/E2_interrupted_recovery_example16/baseline/trial_04R/work/mesh/mesh.exo" dimension 3 overwrite

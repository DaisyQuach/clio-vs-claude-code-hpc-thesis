## Frozen workflow EX16 (FROZEN-EX16-v1) -- full cantilever design domain
## Brick x in [0,2], y in [0,1], z in [0,1]; structured HEX8 mesh, h = 1/24
## 48 x 24 x 24 = 27,648 elements, 30,625 nodes
## block_1 : all elements ; ns_fix : all nodes on x = 0 face ; ns_load : nodes on edge x = 2, y = 0
reset
brick x 2.0 y 1.0 z 1.0
## brick is created centred at the origin; move so the corner sits at the origin
move volume 1 x 1.0 y 0.5 z 0.5 include_merged
## explicit intervals: 48 along x (curves whose centre lies at x = 1), 24 along y and z
curve all interval 24
curve with x_coord > 0.5 and x_coord < 1.5 interval 48
volume 1 scheme map
mesh volume 1
block 1 add volume 1
block 1 name "block_1"
block 1 element type HEX8
## fixed face x = 0 (surface whose centre is at x = 0)
nodeset 1 add surface with x_coord < 0.001
nodeset 1 name "ns_fix"
## loaded edge x = 2, y = 0 (curve whose centre is at x = 2, y = 0)
nodeset 2 add curve with x_coord > 1.999 and y_coord < 0.001
nodeset 2 name "ns_load"
list block 1
list nodeset 1
list nodeset 2
export mesh "mesh.exo" dimension 3 overwrite

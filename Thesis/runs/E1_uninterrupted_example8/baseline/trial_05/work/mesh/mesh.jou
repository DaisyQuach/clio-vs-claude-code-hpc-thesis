# Frozen workflow EX8 (FROZEN-EX8-v1): half cantilever design domain
# Domain: x in [0,2], y in [0,1], z in [0,0.5]; HEX8 mapped mesh, h = 1/24
# Generated for trial E1-example8-baseline-05 with Coreform Cubit 2026.8 (batch)
reset
# brick is created centred at the origin; move it so the corner sits at the origin
brick x 2.0 y 1.0 z 0.5
move volume 1 x 1.0 y 0.5 z 0.25
# structured (mapped) hex mesh with uniform element size h = 1/24
volume 1 scheme map
volume 1 size 0.041666666666667
mesh volume 1
# single element block containing every element
block 1 add volume 1
block 1 name "block_1"
block 1 element type hex8
# nodeset ns_fix: all nodes on the face x = 0
nodeset 1 add node with x_coord < 1.0e-6
nodeset 1 name "ns_fix"
# nodeset ns_load: all nodes on the edge x = 2, y = 0 (spanning z in [0,0.5])
nodeset 2 add node with x_coord > 1.999999 and y_coord < 1.0e-6
nodeset 2 name "ns_load"
# sideset ss_sym: all element faces on the cut plane z = 0.5
sideset 1 add surface with z_coord > 0.499999
sideset 1 name "ss_sym"
# export Exodus II, dimension 3
export mesh "/uufs/chpc.utah.edu/common/home/chet/Daisy/Thesis/runs/E1_uninterrupted_example8/baseline/trial_05/work/mesh/mesh.exo" dimension 3 overwrite

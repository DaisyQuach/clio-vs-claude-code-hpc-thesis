## FROZEN-EX8-v1 half-cantilever mesh (trial E1-example8-baseline-04R2)
## Domain: x in [0,2], y in [0,1], z in [0,0.5]; symmetry (cut) plane z = 0.5
## Structured HEX8 mesh, h = 1/24 -> 48 x 24 x 12 = 13824 elements, 15925 nodes
reset
brick x 2 y 1 z 0.5
## brick is created centred at the origin; shift so the corner sits at the origin
move volume 1 x 1 y 0.5 z 0.25 include_merged
volume 1 size 0.0416666666666667
volume 1 scheme map
mesh volume 1
## single optimizable element block containing every element
block 1 add volume 1
block 1 name "block_1"
block 1 element type hex8
## nodeset ns_fix: all nodes on the face x = 0 (325 nodes)
nodeset 1 add surface with x_coord < 0.001
nodeset 1 name "ns_fix"
## nodeset ns_load: all nodes on the edge x = 2, y = 0, z in [0, 0.5] (13 nodes)
nodeset 2 add curve with x_coord > 1.999 and y_coord < 0.001
nodeset 2 name "ns_load"
## sideset ss_sym: all element faces on the cut plane z = 0.5 (1152 faces)
sideset 1 add surface with z_coord > 0.499
sideset 1 name "ss_sym"
list block 1
list nodeset 1
list nodeset 2
list sideset 1
export mesh "mesh.exo" dimension 3 overwrite

# FROZEN-EX8-v1 half cantilever mesh: brick x[0,2] y[0,1] z[0,0.5], HEX8 48x24x12, h=1/24
reset
brick x 2.0 y 1.0 z 0.5
move volume 1 x 1.0 y 0.5 z 0.25 include_merged
volume 1 scheme map
volume 1 size 0.041666666666667
mesh volume 1
# element block: entire domain designable
block 1 add volume 1
block 1 name 'block_1'
block 1 element type HEX8
# fixed face x = 0 (all nodes)
nodeset 1 add node with x_coord < 1.0e-6
nodeset 1 name 'ns_fix'
# loaded edge x = 2, y = 0, z in [0,0.5] (all nodes)
nodeset 2 add node with x_coord > 1.999999 and y_coord < 1.0e-6
nodeset 2 name 'ns_load'
# symmetry (cut) plane z = 0.5 as a sideset of element faces
sideset 1 add surface with z_coord > 0.499999
sideset 1 name 'ss_sym'
list block 1
list nodeset 1
list nodeset 2
list sideset 1
export mesh "/uufs/chpc.utah.edu/common/home/chet/Daisy/Thesis/runs/E1_uninterrupted_example8/clio/trial_03R/work/mesh/mesh.exo" dimension 3 overwrite

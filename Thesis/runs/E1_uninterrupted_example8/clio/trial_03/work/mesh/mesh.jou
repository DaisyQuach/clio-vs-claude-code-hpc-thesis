# FROZEN-EX8-v1 half cantilever mesh: brick x[0,2] y[0,1] z[0,0.5], HEX8 mapped 48x24x12
reset
brick x 2.0 y 1.0 z 0.5
move volume 1 x 1.0 y 0.5 z 0.25 include_merged
# intervals: 24 on unit edges, 48 on length-2 edges, 12 on half-width edges
curve with length > 0.75 interval 24
curve with length > 1.5 interval 48
curve with length < 0.75 interval 12
volume 1 scheme map
mesh volume 1
# element block
block 1 add volume 1
block 1 name "block_1"
block 1 element type HEX8
# nodeset ns_fix: all nodes on face x = 0
nodeset 1 add node with x_coord < 1.0e-6
nodeset 1 name "ns_fix"
# nodeset ns_load: all nodes on edge x = 2, y = 0
nodeset 2 add node with x_coord > 1.999999
nodeset 2 remove node with y_coord > 1.0e-6
nodeset 2 name "ns_load"
# sideset ss_sym: faces on the cut plane z = 0.5
sideset 1 add surface with z_coord > 0.499999
sideset 1 name "ss_sym"
list block 1
list nodeset 1
list nodeset 2
list sideset 1
export mesh "mesh.exo" dimension 3 overwrite
